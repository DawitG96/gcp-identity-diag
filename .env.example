# Copia in ~/.config/claude-int-aziendale.env e compila con i valori reali.
# NON versionare il file compilato: qui solo placeholder.

# Proxy aziendale: host:porta + credenziali
CORP_PROXY_HOST=proxy.example.local:8080
CORP_PROXY_USER=''
CORP_PROXY_PASS=''

# Domini/reti da escludere dal proxy
CORP_NO_PROXY=localhost,127.0.0.1,.example.local,10.0.0.0/8

# Vertex AI / LLM proxy aziendale
CORP_VERTEX_PROJECT=my-gcp-project-id
CORP_VERTEX_BASE_URL=https://llm-proxy.example.local
CORP_ML_REGION=europe-west1
CORP_GCLOUD_CONFIG=myconfig
CORP_ADC_FILE=$HOME/.config/gcloud/adc.json
CORP_ROOT_CA=$HOME/.config/corp-root-ca.pem
